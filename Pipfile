[[source]]
url = "https://pypi.python.org/simple"
verify_ssl = true
name = "pypi"

[[source]]
name = "alpine-wheels"
# https://github.com/imranq2/alpine-wheels/
url = "https://imranq2.github.io/alpine-wheels/docs/"
verify_ssl = true

[packages]
# PyYAML is a Python library for working with YAML files
PyYAML = ">=6.0.3"
# langchain-core is a Python library for building language models
langchain-core = ">=1.0.0"
# pydantic is a Python library for data validation
pydantic = ">=2.0,<3.0.0"  # needed by langchain
# langchain is a Python library for building language models
langchain = ">=1.0.0"
# fsspec is a Python library for working with filesystems
fsspec = ">=2026.2.0"
# s3fs is a Python library for working with S3 filesystems
s3fs = ">=2026.2.0"
# requests is needed for making HTTP requests
requests = "*"
# aiohttp is needed for making asynchronous HTTP requests
aiohttp = ">=3.8.0"
# simple-container is a Python library for working with containers
simple-container = ">=1.0.2"
# skillkit[langchain] is needed for working with langchain in skillkit
skillkit = {extras = ["langchain"], version = ">=0.4.0"}
# pydantic-ai-skills is needed for working with pydantic in skillkit
pydantic-ai-skills = {extras=["git"], version = ">=0.5.1"}
# aiofiles is needed for working with files asynchronously
aiofiles = ">=25.1.0"
# uv is needed for running python code in a subprocess, which is used by the subprocess tool and the code execution tool
uv = ">=0.11.0"
# anyio is needed for working with asynchronous code in a subprocess, which is used by the subprocess tool and the code execution tool
anyio = ">=4.12.1"
# motor is needed for working with MongoDB asynchronously, which is used by the MongoDB tool
motor = ">=3.7.1"
# skills_ref is needed for working with skills in skillkit. https://github.com/agentskills/agentskills/tree/main/skills-ref
skills_ref = ">=0.1.1"

[dev-packages]
# setuptools > 81 has a breaking change that causes pipenv-setup to fail, so we need to pin it to a version < 80.9.0
setuptools=">=60.9.3, <=80.9.0"
packaging= ">=26.0"
wheel = ">=0.43.0"
twine=">=4.0.2"
pre-commit=">=3.6.1"
autoflake=">=2.2.0"
mypy = ">=1.8.0"
pytest = ">=8.1.1"
pytest-asyncio = ">=0.23.6"
black = ">=24.2.0"
# bandit is needed for security checks
bandit = ">=1.8.3"
# ruff is needed for linting
ruff = ">=0.11.5"
# pytest-cov is needed for measuring test coverage
pytest-cov = ">=6.1.1"
# types-PyYAML provides type hints for PyYAML
types-PyYAML = ">=6.0.12"
types-requests = ">=2.32.4"

# These dependencies are required for pipenv-setup.  They conflict with ones above, so we install these
# only when running pipenv-setup
[pipenvsetup]
# vistr is needed for visualizing the dependency graph
vistir=">=0.6.1, <0.7.0" # https://github.com/Madoshakalaka/pipenv-setup/issues/138
# plete is needed for tab completion
plette = "<1.0.0" # https://github.com/Madoshakalaka/pipenv-setup/issues/138
# pipenv-setup is needed for updating setup.py with the dependencies for anyone installing this package
pipenv-setup = ">=3.2.0"
# setuptools > 81 has a breaking change that causes pipenv-setup to fail, so we need to pin it to a version < 80.9.0
setuptools=">=60.9.3, <=80.9.0"
# packaging
packaging = "~=20.0"

[requires]
python_version = "3.12"

[pipenv]
allow_prereleases = false
